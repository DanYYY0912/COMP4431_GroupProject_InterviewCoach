# Copy to .env. Keep secrets out of version control.
# Demo is deterministic; llama uses the real local base or trained model.
MODEL_PROVIDER=demo
MODEL_PATH=models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
MODEL_NAME=Qwen3-4B-Instruct-2507
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
WHISPER_BASE_URL=http://127.0.0.1:8081
WHISPER_MODEL_PATH=models/ggml-large-v3-turbo-q5_0.bin
# Leave DATABASE_URL absent for PostgreSQL auto-start with SQLite fallback.
# DATABASE_URL=sqlite:///./data/voxprep.db
# EMBEDDING_BASE_URL=http://127.0.0.1:8082/v1
# RERANKER_BASE_URL=http://127.0.0.1:8083/v1
# Never paste credentials into chat; fill them here only.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Container app can reach host-native retrieval through Docker Desktop:
# CONTAINER_EMBEDDING_BASE_URL=http://host.docker.internal:8082/v1
# CONTAINER_RERANKER_BASE_URL=http://host.docker.internal:8083/v1
